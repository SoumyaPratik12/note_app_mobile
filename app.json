{
  "expo": {
    "name": "InkSync",
    "slug": "inksync",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "inksync",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.inksync.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "InkSync uses the camera to photograph your handwritten notes."
        }
      ],
      "expo-notifications",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8185c6e6-3e56-4453-8c9e-0b35511478c6"
      }
    },
    "owner": "samm123"
  }
}
