# ---------------------------------------------------------------------------
# Client (Expo) — these are read at build time via app.config / process.env.
# The anon key is safe to ship in the app; RLS protects the data.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Edge Functions — set as Supabase secrets, never shipped to the client:
#   supabase secrets set GOOGLE_VISION_API_KEY=... ANTHROPIC_API_KEY=...
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Supabase runtime; the others you provide.
# ---------------------------------------------------------------------------
# GOOGLE_VISION_API_KEY=...
# ANTHROPIC_API_KEY=...
